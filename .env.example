KB_API_KEY=your-opencode-go-api-key
KB_BASE_URL=https://opencode.ai/zen/go/v1
KB_MODEL=kimi-k2.5
# OpenCode Go: use nome simples, sem prefixo (ex.: kimi-k2.5, minimax-2.7, glm-5)

# Diretório de dados do seu vault/corpus local (recomendado fora do repositório do código)
# KB_DATA_DIR=/path/to/your/llm-wiki

# Taxonomia opcional da wiki (separada por vírgulas, sem incluir `general`)
# KB_TOPICS=cybersecurity,ai,python,typescript

# Overrides opcionais por diretório:
# KB_RAW_DIR=/path/to/your/llm-wiki/raw
# KB_WIKI_DIR=/path/to/your/llm-wiki/wiki
# KB_OUTPUTS_DIR=/path/to/your/llm-wiki/outputs
# KB_STATE_DIR=/path/to/your/llm-wiki/kb_state

# Para modelos locais via Ollama, descomente:
# KB_BASE_URL=http://localhost:11434/v1
# KB_API_KEY=ollama
# KB_MODEL=qwen2.5-coder:7b

# --- Retrieval -------------------------------------------------------------
# Canal semântico. Servidor morto degrada a busca para lexical, com aviso:
# no golden de 152 casos isso é recall@5 0,467 -> 0,230.
# KB_EMBED_BASE_URL=http://localhost:1234/v1
# KB_EMBED_MODEL=text-embedding-nomic-embed-text-v2-moe

# Rerank por LLM, opt-in via `kb search --rerank 20`. Provider dedicado porque
# o modelo do rerank não é o do QA.
#
# Medido no mesmo golden (1.033 artigos), recall@5 / MRR:
#   lexical                         0,230 / 0,127
#   hibrido                         0,414 / 0,242
#   hibrido + rerank 20 @ temp 0,8  0,467 / 0,299
#   hibrido + rerank 20 @ temp 0    0,467 / 0,343   <- vencedora
#
# `granite4:tiny-h` é 13x mais rápido e PIOR que não reordenar (0,388): emite
# índices fora do intervalo mesmo em greedy. Temperatura 0 é o que importa —
# subiu a cobertura do bonsai de 75% para 93% dos candidatos pedidos.
# KB_RERANK_BASE_URL=http://localhost:8081/v1
# KB_RERANK_MODEL=bonsai-27b-1bit
